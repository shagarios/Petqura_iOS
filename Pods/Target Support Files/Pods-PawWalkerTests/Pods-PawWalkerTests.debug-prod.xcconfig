CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/CFNetworkSDK" "${PODS_ROOT}/CashfreeAnalyticsSDK" "${PODS_ROOT}/CashfreePG" "${PODS_ROOT}/CashfreePGCoreSDK" "${PODS_ROOT}/CashfreePGUISDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/CFNetworkSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/CashfreeAnalyticsSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/CashfreePG" "${PODS_XCFRAMEWORKS_BUILD_DIR}/CashfreePGCoreSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/CashfreePGUISDK"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
OTHER_LDFLAGS = $(inherited) -framework "CFNetworkSDK" -framework "CashfreeAnalyticsSDK" -framework "CashfreePG" -framework "CashfreePGCoreSDK" -framework "CashfreePGUISDK"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
